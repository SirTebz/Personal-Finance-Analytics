# Use a SQL Server URL in production, for example:
# DATABASE_URL=mssql+pyodbc://user:password@server/PersonalFinance?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# SQLite is used automatically for local development when this is blank.
DATABASE_URL=
SECRET_KEY=replace-with-a-long-random-value
FLASK_ENV=development
